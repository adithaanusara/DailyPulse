# Settings for the local Docker environment.
# bin/setup.sh copies this file to .env on first run; edit .env, not this file.

# The site is served at http://localhost:<WP_PORT>
WP_PORT=8090

# Used once, when WordPress is installed. Local development only — never reuse these on a live site.
WP_TITLE=DailyPulse
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
WP_TIMEZONE=Asia/Colombo

# 1 logs PHP notices and errors to wp-content/debug.log, 0 switches that off.
WP_DEBUG=1
